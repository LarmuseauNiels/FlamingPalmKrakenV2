{
  "schemaVersion": 2,
  "dockerfileLines":
    [
        "FROM node:24-alpine AS builder",
        "RUN apk add --no-cache openssl",
        "WORKDIR /usr/src/app",
        "COPY package.json package-lock.json ./",
        "RUN npm ci",
        "COPY . .",
        "RUN npx prisma generate && npx tsc",
        "# Activity SPA (own package.json / lockfile, separate from the bot build)",
        "RUN npm --prefix activity ci --no-audit --no-fund && npm --prefix activity run build",

        "FROM node:24-alpine",
        "# ffmpeg + python3 for the music player (modules/Music); yt-dlp itself is installed below",
        "RUN apk add --no-cache openssl ffmpeg python3 py3-pip",
        "COPY ./fonts/Manrope-Bold.ttf ./fonts/Manrope-Regular.ttf /tmp/fonts/",
        "RUN mkdir -p /usr/share/fonts/truetype/ && install -m644 /tmp/fonts/Manrope-Bold.ttf /usr/share/fonts/truetype/ && install -m644 /tmp/fonts/Manrope-Regular.ttf /usr/share/fonts/truetype/ && rm -rf /tmp/fonts",
        "ARG CAPROVER_GIT_COMMIT_SHA=${CAPROVER_GIT_COMMIT_SHA}",
        "ENV CAPROVER_GIT_COMMIT_SHA=${CAPROVER_GIT_COMMIT_SHA}",
        "# After the commit-SHA ARG on purpose: every deploy misses the cache here and pulls the latest yt-dlp, which YouTube changes keep requiring",
        "RUN pip install --no-cache-dir --break-system-packages --upgrade 'yt-dlp[default]' && yt-dlp --version",
        "ENV NODE_ENV production",
        "ENV PORT 80",
        "EXPOSE 80",
        "WORKDIR /usr/src/app",
        "COPY package.json package-lock.json ./",
        "RUN npm ci --omit=dev",
        "COPY --from=builder /usr/src/app/bin ./bin",
        "COPY --from=builder /usr/src/app/node_modules/.prisma ./node_modules/.prisma",
        "COPY prisma ./prisma",
        "COPY assets ./assets",
        "COPY --from=builder /usr/src/app/activity/dist ./activity/dist",
        "CMD [ \"npm\", \"start\" ]"
    ]
 }
